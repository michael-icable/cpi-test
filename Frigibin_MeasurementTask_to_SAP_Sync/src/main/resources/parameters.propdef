<?xml version="1.0" encoding="UTF-8" standalone="no"?><parameters><parameter>
    <key/>
    <name>DEV Location ID</name>
    <type>xsd:string</type>
    <isRequired>true</isRequired>
    <constraint/>
    <description>Cloud Connector location ID of the target</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>DEV Schedule</name>
    <type>custom:schedule</type>
    <isRequired>true</isRequired>
    <constraint/>
    <description>Timer of the DEV target</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>DEV Sync Enabled</name>
    <type>xsd:boolean</type>
    <isRequired>true</isRequired>
    <constraint/>
    <description>false = the DEV run ends immediately (pause)</description>
    <additionalMetadata>
      <isCombobox>false</isCombobox>
    </additionalMetadata>
  </parameter><parameter>
    <key/>
    <name>DEV Target Host</name>
    <type>xsd:string</type>
    <isRequired>true</isRequired>
    <constraint/>
    <description>Virtual host = credential alias = Data Store entry ID</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>Data Store Expiration Days</name>
    <type>xsd:integer</type>
    <isRequired>true</isRequired>
    <constraint/>
    <description>Expiration of a watermark entry in days</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>Data Store Name</name>
    <type>xsd:string</type>
    <isRequired>true</isRequired>
    <constraint/>
    <description>Data Store of the watermarks</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>Error Handler Address</name>
    <type>xsd:string</type>
    <isRequired>true</isRequired>
    <constraint/>
    <description>ProcessDirect address of the central error handler</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>Full Load Page Size</name>
    <type>xsd:integer</type>
    <isRequired>true</isRequired>
    <constraint/>
    <description>Rows per full-load page (= per applyChanges call)</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>JDBC Data Source Alias</name>
    <type>xsd:string</type>
    <isRequired>true</isRequired>
    <constraint/>
    <description>JDBC material of the MSSQL database</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>JDBC Query Timeout</name>
    <type>xsd:integer</type>
    <isRequired>true</isRequired>
    <constraint/>
    <description>Query timeout in seconds</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>PRD Location ID</name>
    <type>xsd:string</type>
    <isRequired>true</isRequired>
    <constraint/>
    <description>Cloud Connector location ID of the target</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>PRD Schedule</name>
    <type>custom:schedule</type>
    <isRequired>true</isRequired>
    <constraint/>
    <description>Timer of the PRD target</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>PRD Sync Enabled</name>
    <type>xsd:boolean</type>
    <isRequired>true</isRequired>
    <constraint/>
    <description>false = the PRD run ends immediately (pause)</description>
    <additionalMetadata>
      <isCombobox>false</isCombobox>
    </additionalMetadata>
  </parameter><parameter>
    <key/>
    <name>PRD Target Host</name>
    <type>xsd:string</type>
    <isRequired>true</isRequired>
    <constraint/>
