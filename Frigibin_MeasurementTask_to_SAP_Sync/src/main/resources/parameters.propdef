  </parameter><parameter>
    <key/>
    <name>QAS Sync Enabled</name>
    <type>xsd:boolean</type>
    <isRequired>true</isRequired>
    <constraint/>
    <description>false = the QAS run ends immediately (pause)</description>
    <additionalMetadata>
      <isCombobox>false</isCombobox>
    </additionalMetadata>
  </parameter><parameter>
    <key/>
