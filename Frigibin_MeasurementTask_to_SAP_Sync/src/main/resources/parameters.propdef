    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>Package Size</name>
    <type>xsd:integer</type>
    <isRequired>true</isRequired>
    <constraint/>
    <description>Maximum changes per applyChanges call</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>Payload Logging</name>
    <type>xsd:boolean</type>
    <isRequired>true</isRequired>
    <constraint/>
    <description>true = payloads are attached to the MPL</description>
    <additionalMetadata>
      <isCombobox>false</isCombobox>
    </additionalMetadata>
  </parameter><parameter>
    <key/>
    <name>QAS Location ID</name>
    <type>xsd:string</type>
    <isRequired>true</isRequired>
    <constraint/>
    <description>Cloud Connector location ID of the target</description>
    <additionalMetadata/>
  </parameter><parameter>
    <key/>
    <name>QAS Schedule</name>
    <type>custom:schedule</type>
    <isRequired>true</isRequired>
    <constraint/>
